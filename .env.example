# Copy to .env and fill in. Never commit .env.

# "preview" hides the site from search engines and shows a sample-data banner.
NEXT_PUBLIC_SITE_MODE=""

# Postgres. Locally, run `npm run db:dev` (a built-in Prisma Postgres server, no install
# needed), then `npx prisma migrate dev` and `npm run db:seed` for sample partners.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Only needed with `prisma dev`, which serves one database per port.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Better Auth: generate with `npx @better-auth/cli secret`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Stripe (use test-mode keys locally)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# DVLA Vehicle Enquiry Service, for the free reg check. Leave blank to use sample vehicles.
DVLA_VES_API_KEY=""
