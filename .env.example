# Copy to .env and fill in. Never commit .env.

# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/motoring_central"

# Better Auth: generate with `npx @better-auth/cli secret`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Stripe (use test-mode keys locally)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# DVLA Vehicle Enquiry Service, for the free reg check. Leave blank to use sample vehicles.
DVLA_VES_API_KEY=""
